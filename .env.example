ANTHROPIC_API_KEY=<your_key_here>
OPENAI_API_KEY=<your_key_here>
ELEVENLABS_API_KEY=<your_key_here>
DEEPGRAM_API_KEY=<your_key_here>

# Required for banking_knowledge qwen_embeddings* retrieval configs (via OpenRouter)
OPENROUTER_API_KEY=<your_key_here>

# ── LiteLLM gateway (route ALL models through a corporate/self-hosted proxy) ──
# Use this instead of the direct provider keys above when your models are only
# reachable via a LiteLLM proxy. Set the secret + base URL once; the rest re-export
# them under the names each consumer reads. See AGENTS.md "LiteLLM gateway".
#
# LITELLM_API_BASE=https://your-litellm-gateway          # no trailing /v1
# LITELLM_API_KEY=sk-<your_virtual_key>
#
# Consumer 1 & 3 — tau2 agent / user-sim / evaluator (LiteLLM SDK -> proxy).
# Pass models on the CLI as `litellm_proxy/<public-model-name>`:
# LITELLM_PROXY_API_BASE=${LITELLM_API_BASE}
# LITELLM_PROXY_API_KEY=${LITELLM_API_KEY}
#
# Consumer 2 — claude_harness (claude CLI -> proxy's Anthropic /v1/messages).
# BASE_URL must NOT include /v1; model names are the bare gateway public name:
# ANTHROPIC_BASE_URL=${LITELLM_API_BASE}
# ANTHROPIC_AUTH_TOKEN=${LITELLM_API_KEY}
# ANTHROPIC_MODEL=<public-model-name>                    # e.g. aws/claude-sonnet-4-5
# ANTHROPIC_SMALL_FAST_MODEL=<small-public-name>         # e.g. aws/claude-haiku-4-5
# ANTHROPIC_DEFAULT_HAIKU_MODEL=<small-public-name>
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
#
# Consumer 3 — tau2 evaluator/judge (hardcoded in config.py, no CLI flag):
# TAU2_LLM_NL_ASSERTIONS=litellm_proxy/<public-model-name>
# TAU2_LLM_ENV_INTERFACE=litellm_proxy/<public-model-name>
# TAU2_LLM_EVAL_USER_SIMULATOR=litellm_proxy/<public-model-name>

# ── In-situ harness model gateway (higher-order harness) ───────────────
# Per-role model selection for the in-situ eval loop. Lets the user-simulator /
# judge run on a LOCAL MLX server (Apple Silicon, Qwen 8-bit, OpenAI-compatible),
# the LiteLLM proxy, or a cloud provider — see harnesses/docs/higher-order-harness.md §7.
# Provider: mlx | openai | anthropic | litellm  (default: mlx)
# TAU2_USER_SIM_PROVIDER=mlx
# TAU2_USER_SIM_MODEL=mlx-community/Qwen3-30B-A3B-8bit   # MUST match the id mlx_lm.server loaded
# TAU2_USER_SIM_API_BASE=http://localhost:8080/v1        # mlx_lm.server / LM Studio
# TAU2_USER_SIM_API_KEY=mlx                              # dummy ok for local
# Optional passthrough to the served model. A REASONING model (e.g. Qwen3) MUST disable
# thinking for the user-sim role, else it burns the token budget on <think> and returns
# empty content. 512 completion tokens is ample for a user turn.
# TAU2_USER_SIM_MAX_TOKENS=512
# TAU2_USER_SIM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# Trajectory scoring is a SEPARATE seam — not these knobs. Most checks are deterministic
# (no model); only nl_assertions use an LLM judge, set via TAU2_LLM_NL_ASSERTIONS above
# (default gpt-4.1). See docs/mlx-user-sim-setup.md §7.

# ── Voice Persona Overrides ────────────────────────────────────────────
# The default voice IDs are Sierra-internal and won't work for external users.
# Create your own voices in ElevenLabs and set the IDs here.
# See docs/voice-personas.md for a step-by-step guide.
#
# Control personas (American accents, used in "control" complexity):
# TAU2_VOICE_ID_MATT_DELANEY=<your_voice_id>
# TAU2_VOICE_ID_LISA_BRENNER=<your_voice_id>
#
# Regular personas (diverse accents, used in "regular" complexity):
# TAU2_VOICE_ID_MILDRED_KAPLAN=<your_voice_id>
# TAU2_VOICE_ID_ARJUN_ROY=<your_voice_id>
# TAU2_VOICE_ID_WEI_LIN=<your_voice_id>
# TAU2_VOICE_ID_MAMADOU_DIALLO=<your_voice_id>
# TAU2_VOICE_ID_PRIYA_PATIL=<your_voice_id>
